# FACULTATIF. Le plus simple : ouvre l'onglet « Réglages » du dashboard, tout s'y règle sans éditer de fichier.
# Ce fichier sert seulement si tu préfères tout écrire à la main (la page Réglages a priorité sur lui).
# Copie-le en ".env" et ne le publie JAMAIS (il est ignoré par git).

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- IA : gemini (gratuit, https://aistudio.google.com/apikey), claude ou none ---
AI_PROVIDER=
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
ANTHROPIC_API_KEY=
